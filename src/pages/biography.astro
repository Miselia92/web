---
import Layout from '@/layouts/Layout.astro';
import { getAbout } from '@/lib/content-tina';
import { RichText } from '@/components/tina/RichText';
import OptimizedImage from '@/components/OptimizedImage.astro';

const page = await getAbout();
const { portraitImage, title, title_zh, body, body_zh } = page;
---

<Layout title={`${title} | Mark Power`}>
  <div class="px-6 md:px-12 py-12 max-w-7xl mx-auto flex flex-col md:flex-row gap-12">
    <div class="md:w-1/3">
      <div class="aspect-[3/4] bg-muted w-full relative">
        <!-- Placeholder for Portrait -->
        {portraitImage ? (
          <OptimizedImage 
            src={portraitImage} 
            alt="Portrait of Mark Power" 
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="absolute inset-0 flex items-center justify-center text-muted-foreground uppercase tracking-widest text-xs">
            Portrait
          </div>
        )}
      </div>
    </div>
    
    <div class="md:w-2/3">
      <h1 class="text-3xl font-light mb-8 uppercase tracking-wide">
        <span class="lang-en-only">{title}</span>
        <span class="lang-zh-only">{title_zh || title}</span>
      </h1>
      <div class="prose prose-stone prose-lg max-w-none text-muted-foreground font-light">
        <div class="lang-en-only"><RichText content={body} client:visible /></div>
        <div class="lang-zh-only"><RichText content={body_zh} client:visible /></div>
      </div>
    </div>
  </div>
</Layout>
