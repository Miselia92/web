---
import Layout from '@/layouts/Layout.astro';
import { getWritings } from '@/lib/content-tina';
import { RichText } from '@/components/tina/RichText';

export async function getStaticPaths() {
  const writings = await getWritings();
  return writings.map((essay) => ({
    params: { slug: essay._sys.filename },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { title, title_zh, date, coverImage, body, body_zh } = essay;

const formatDate = (dateString: string, locale: string = 'en') => {
  if (!dateString) return '';
  const dateObj = new Date(dateString);
  if (locale === 'zh') {
      return new Intl.DateTimeFormat('zh-TW', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      }).format(dateObj);
  }
  return new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(dateObj);
};
---

<Layout title={`${title} | Mark Power`}>
  <article class="px-6 md:px-12 py-12 max-w-3xl mx-auto">
    <header class="mb-12">
      <h1 class="text-3xl md:text-5xl font-bold mb-6 uppercase tracking-wide">
        <span class="lang-en-only">{title}</span>
        <span class="lang-zh-only">{title_zh || title}</span>
      </h1>
      <div class="text-xs uppercase tracking-widest text-muted-foreground">
        <time datetime={date}>
            <span class="lang-en-only">{formatDate(date, 'en')}</span>
            <span class="lang-zh-only">{formatDate(date, 'zh')}</span>
        </time>
      </div>
    </header>
    
    {coverImage && (
      <div class="mb-12">
        <img 
          src={coverImage} 
          alt={title}
          class="w-full h-auto"
        />
      </div>
    )}
    
    <div class="prose prose-lg prose-neutral max-w-none text-foreground">
      <div class="lang-en-only">
        <RichText content={body} client:visible />
      </div>
      {body_zh && (
        <div class="lang-zh-only">
            <RichText content={body_zh} client:visible />
        </div>
      )}
    </div>
  </article>
</Layout>
