---
import Layout from '@/layouts/Layout.astro';
import { getProjects } from '@/lib/content-tina';
import { getTranslation } from '@/lib/i18n';
import OptimizedImage from '@/components/OptimizedImage.astro';

const projects = await getProjects();
// Sort by year desc or order
projects.sort((a, b) => {
  const orderA = a.order ?? 99;
  const orderB = b.order ?? 99;
  if (orderA !== orderB) return orderA - orderB;
  return (b.year || '0').localeCompare(a.year || '0');
});

// Group projects by subProjectClassification
const groupedProjects = projects.reduce((acc, project) => {
  const classification = project.subProjectClassification || 'Others';
  if (!acc[classification]) {
    acc[classification] = [];
  }
  acc[classification].push(project);
  return acc;
}, {} as Record<string, typeof projects>);

// Get sorted keys (classifications), moving "Others" to the bottom
const sortedClassifications = Object.keys(groupedProjects).sort((a, b) => {
  if (a === 'Others') return 1;
  if (b === 'Others') return -1;
  return a.localeCompare(b);
});
---

<Layout title="Projects | Mark Power">
  <div class="px-6 md:px-12 py-12">
    <h1 class="text-3xl font-light mb-12 uppercase tracking-wide">
        <span class="lang-en-only">Projects</span>
        <span class="lang-zh-only">作品</span>
    </h1>
    
    <div class="space-y-16">
      {sortedClassifications.map((classification) => {
        // Find a Chinese translation for this classification from any project in the group
        const zhClassification = groupedProjects[classification].find(p => p.subProjectClassification_zh)?.subProjectClassification_zh;
        
        return (
        <section>
          {classification !== 'Others' && (
            <h2 class="text-xl font-light mb-8 text-primary border-b pb-2">
                <span class="lang-en-only">{getTranslation('en').categories[classification] || classification}</span>
                <span class="lang-zh-only">{getTranslation('zh').categories[classification] || zhClassification || classification}</span>
            </h2>
          )}
          {classification === 'Others' && sortedClassifications.length > 1 && (
             <h2 class="text-xl font-light mb-8 text-primary border-b pb-2">
                <span class="lang-en-only">Others</span>
                <span class="lang-zh-only">其他</span>
             </h2>
          )}
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 gap-y-12">
            {groupedProjects[classification].map((project) => (
              <a href={`/projects/${project._sys.filename}`} class="group block">
                <div class="aspect-[4/3] bg-muted overflow-hidden mb-4 relative">
                   {project.coverImage ? (
                      <OptimizedImage 
                        src={project.coverImage} 
                        alt={project.title} 
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      />
                   ) : (
                      <div class="w-full h-full flex items-center justify-center text-muted-foreground uppercase tracking-widest text-xs">
                        No Cover
                      </div>
                   )}
                </div>
                <h2 class="text-lg font-normal group-hover:text-muted-foreground transition-colors uppercase tracking-wide">
                  <span class="lang-en-only">{project.title}</span>
                  <span class="lang-zh-only">{project.title_zh || project.title}</span>
                </h2>
                {project.year && (
                  <p class="text-xs text-muted-foreground mt-1">{project.year}</p>
                )}
              </a>
            ))}
          </div>
        </section>
        );
      })}
    </div>
  </div>
</Layout>
