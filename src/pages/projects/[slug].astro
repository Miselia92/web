---
import Layout from '@/layouts/Layout.astro';
import { getProjects } from '@/lib/content-tina';
import { RichText } from '@/components/tina/RichText';
import OptimizedImage from '@/components/OptimizedImage.astro';
import { ProjectLightbox } from '@/components/ProjectLightbox';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project._sys.filename },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, title_zh, year, body, body_zh, images, subProjectClassification, description, description_zh } = project;

const getYouTubeId = (url: string) => {
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
  const match = url.match(regExp);
  return (match && match[2].length === 11) ? match[2] : null;
};
---

<Layout title={`${title} | Mark Power`}>
  <div class="px-6 md:px-12 py-12 max-w-7xl mx-auto">
    
    <div class="mb-16 md:w-2/3">
      <h1 class="text-3xl md:text-5xl font-bold mb-6 uppercase tracking-wide">
        <span class="lang-en-only">{title}</span>
        <span class="lang-zh-only">{title_zh || title}</span>
      </h1>
      <div class="text-sm md:text-base leading-relaxed text-muted-foreground space-y-4 max-w-prose">
        {subProjectClassification && (
            <p class="text-lg text-primary mb-2">
                <span class="lang-en-only">{subProjectClassification}</span>
                <span class="lang-zh-only">{project.subProjectClassification_zh || subProjectClassification}</span>
            </p>
        )}
        <p class="text-muted-foreground mb-6">{year}</p>
        {description && (
          <div class="mb-6">
            <p class="lang-en-only whitespace-pre-line">{description}</p>
            <p class="lang-zh-only whitespace-pre-line">{description_zh || description}</p>
          </div>
        )}
        <div class="lang-en-only">
            <RichText content={body} client:visible />
        </div>
        {body_zh && (
            <div class="lang-zh-only">
                <RichText content={body_zh} client:visible />
            </div>
        )}
      </div>
    </div>

    {images && images.length > 0 && (
      <div class="space-y-12 md:space-y-24">
        {images.map((image, index) => {
          if (image?.youtubeUrl) {
            const videoId = getYouTubeId(image.youtubeUrl);
            if (videoId) {
              return (
                <div class="max-w-4xl mx-auto mb-12" data-index={index}>
                  <div class="plyr-youtube-container rounded-lg overflow-hidden shadow-md">
                    <div 
                      class="plyr-youtube" 
                      data-plyr-provider="youtube" 
                      data-plyr-embed-id={videoId}
                    ></div>
                  </div>
                  {image.description && (
                    <p class="mt-4 text-sm text-gray-600 italic dark:text-gray-500">
                        <span class="lang-en-only">{image.description}</span>
                        <span class="lang-zh-only">{image.description_zh || image.description}</span>
                    </p>
                  )}
                </div>
              );
            }
          }

          return (image?.src) && (
          <div 
            class="max-w-4xl mx-auto project-image-trigger cursor-pointer" 
            data-index={index}
          >
            <OptimizedImage 
              src={image.src} 
              alt={`${title} - Image ${index + 1}`}
              class="w-full h-auto shadow-md"
            />
             {image.description && (
              <p class="mt-4 text-sm text-gray-600 italic dark:text-gray-500">
                  <span class="lang-en-only">{image.description}</span>
                  <span class="lang-zh-only">{image.description_zh || image.description}</span>
              </p>
            )}
          </div>
          )
        })}
      </div>
    )}


    {images && images.length > 0 && (
      <ProjectLightbox images={images} client:idle />
    )}
  </div>
</Layout>

<script>
  // Initialize Plyr for all YouTube videos (dynamic import to avoid SSR issues)
  async function initPlyr() {
    const Plyr = (await import('plyr')).default;
    document.querySelectorAll('.plyr-youtube').forEach((element) => {
      new Plyr(element, {
        controls: [
          'play-large', 'play', 'progress', 'current-time', 
          'mute', 'volume', 'settings', 'fullscreen'
        ],
        youtube: {
          noCookie: true,
          rel: 0,
          showinfo: 0,
          iv_load_policy: 3,
          modestbranding: 1
        }
      });
    });
  }
  initPlyr();

  // Add click listeners to all project images
  const imageContainers = document.querySelectorAll('.project-image-trigger');
  
  imageContainers.forEach((container) => {
    container.addEventListener('click', () => {
      const index = parseInt(container.getAttribute('data-index') || '0', 10);
      
      // Dispatch custom event to open lightbox
      const event = new CustomEvent('open-project-lightbox', {
        detail: { index }
      });
      window.dispatchEvent(event);
    });
  });
</script>

