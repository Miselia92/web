---
import { getEntry } from 'astro:content';
import { getGlobal } from '@/lib/content-tina';
import { Header } from '@/components/layout/Header';
import { Footer } from '@/components/layout/Footer';

import '@/styles/global.css';

interface Props {
	title: string;
	description?: string;
    seo?: {
        title?: string;
        description?: string;
        image?: string;
        canonical?: string;
    }
}

const { title, description = "The photography of Mark Power.", seo } = Astro.props;

const home = await getEntry('pages', 'home');
const globalConfig = await getGlobal();
const brandName = home?.data?.brandName || globalConfig.siteTitle;
const brandNameZh = home?.data?.brandName_zh || globalConfig.siteTitle_zh;

const finalTitle = seo?.title || globalConfig.seo?.title || title;
const finalDescription = seo?.description || globalConfig.seo?.description || description;
const finalImage = seo?.image || globalConfig.seo?.image;
const finalCanonical = seo?.canonical || globalConfig.seo?.canonical;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
        <script is:inline>
            // Initialize language class immediately to prevent FOUC
            const savedLang = localStorage.getItem('site_language');
            const browserLang = navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en';
            const lang = savedLang || browserLang;
            document.documentElement.classList.add(`lang-${lang}`);
        </script>
		<meta name="description" content={finalDescription} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{finalTitle}</title>
        {finalImage && <meta property="og:image" content={finalImage} />}
        {finalCanonical && <link rel="canonical" href={finalCanonical} />}
        <meta property="og:title" content={finalTitle} />
        <meta property="og:description" content={finalDescription} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
		<!-- Plyr CSS for styled video players -->
		<link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />
		<style>
			/* Custom Plyr theme - white accent */
			:root {
				--plyr-color-main: #ffffff;
				--plyr-video-control-color: #ffffff;
				--plyr-video-control-color-hover: rgba(255, 255, 255, 0.8);
				--plyr-range-fill-background: #ffffff;
				--plyr-badge-background: #ffffff;
				--plyr-badge-text-color: #000000;
			}
		</style>
	</head>
	<body class="flex flex-col min-h-screen text-foreground bg-background antialiased font-sans">
		<Header client:load brandName={brandName} brandNameZh={brandNameZh} />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
